{
  "name": "parlante-xion",
  "version": "1.0.1",
  "description": "🎧 a self-hosted Discord music bot that doesn't suck, using NodeLink as audio server",
  "license": "MIT",
  "author": "Avi Tretiak <avi@babi.uy>",
  "repository": "git@github.com:avitretiak/parlante-xion.git",
  "imports": {
    "#parlante/config": "./src/services/config.ts",
    "#parlante/db": "./src/db/index.ts",
    "#parlante/db/schema": "./src/db/schema.ts",
    "#parlante/managers/players": "./src/managers/players.ts",
    "#parlante/services/queue-service": "./src/services/queue-service.ts",
    "#parlante/services/search": "./src/services/search.ts",
    "#parlante/structures/kazagumo": "./src/structures/kazagumo.ts",
    "#parlante/types": "./src/types/index.ts",
    "#parlante/types/commands": "./src/types/commands.ts",
    "#parlante/types/db": "./src/types/db.ts",
    "#parlante/types/player": "./src/types/player.ts",
    "#parlante/types/services": "./src/types/services.ts",
    "#parlante/utils/config/create-database-url": "./src/utils/config/create-database-url.ts",
    "#parlante/utils/config/get-guild-settings": "./src/utils/config/get-guild-settings.ts",
    "#parlante/utils/constants/constants": "./src/utils/constants/constants.ts",
    "#parlante/utils/constants/messages": "./src/utils/constants/messages.ts",
    "#parlante/utils/error/errors": "./src/utils/error/errors.ts",
    "#parlante/utils/general/arrays": "./src/utils/general/arrays.ts",
    "#parlante/utils/general/string": "./src/utils/general/string.ts",
    "#parlante/utils/general/time": "./src/utils/general/time.ts",
    "#parlante/utils/general/url": "./src/utils/general/url.ts",
    "#parlante/utils/player/build-now-playing-embed": "./src/utils/player/build-now-playing-embed.ts",
    "#parlante/utils/player/get-progress-bar": "./src/utils/player/get-progress-bar.ts",
    "#parlante/utils/system/command-queue": "./src/utils/system/command-queue.ts",
    "#parlante/utils/system/logger": "./src/utils/system/logger.ts",
    "#parlante/utils/system/log-banner": "./src/utils/system/log-banner.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "dev": "bun run src/index.ts",
    "migrate-and-start": "bun run src/index.ts",
    "lint": "bunx oxlint .",
    "lint:fix": "bunx oxlint --fix .",
    "format": "bunx oxfmt .",
    "format:check": "bunx oxfmt --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@logtape/logtape": "^2.0.4",
    "@logtape/pretty": "^2.0.4",
    "drizzle-orm": "^0.45.1",
    "kazagumo": "^3.4.1",
    "seyfert": "^4.2.0",
    "shoukaku": "^4.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.3",
    "drizzle-kit": "^0.31.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,js,json}": [
      "bunx oxlint --fix",
      "bunx oxfmt"
    ]
  },
  "target": "bun"
}
