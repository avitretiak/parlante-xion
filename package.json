{
  "name": "parlante-xion",
  "version": "1.0.1",
  "description": "🎧 a self-hosted Discord music bot that doesn't suck, using NodeLink as audio server",
  "license": "MIT",
  "author": "Avi Tretiak <avi@babi.uy>",
  "repository": "git@github.com:avitretiak/parlante-xion.git",
  "imports": {
    "#parlante/config": "./src/services/config.ts",
    "#parlante/db": "./src/db/index.ts",
    "#parlante/db/schema": "./src/db/schema.ts",
    "#parlante/types": "./src/types/index.ts",
    "#parlante/*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "dev": "bun run src/index.ts",
    "migrate-and-start": "bun run src/index.ts",
    "lint": "bunx oxlint .",
    "lint:fix": "bunx oxlint --fix .",
    "format": "bunx oxfmt .",
    "format:check": "bunx oxfmt --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@logtape/logtape": "^2.0.5",
    "@logtape/pretty": "^2.0.5",
    "drizzle-orm": "^0.45.2",
    "kazagumo": "^3.4.1",
    "seyfert": "^4.2.0",
    "shoukaku": "^4.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.2",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2"
  },
  "lint-staged": {
    "*.{ts,js,json}": [
      "bunx oxlint --fix",
      "bunx oxfmt"
    ]
  },
  "target": "bun"
}
