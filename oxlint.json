{
  "extends": ["oxc/recommended"],
  "env": {
    "node": true,
    "browser": true,
    "es2024": true
  },
  "settings": {
    "jsx-a11y": {}
  },
  "rules": {
    "complexity/noBannedTypes": "off",
    "style/noNonNullAssertion": "off"
  },
  "ignorePatterns": ["node_modules/", "dist/", "nodelink-repo/"]
}
